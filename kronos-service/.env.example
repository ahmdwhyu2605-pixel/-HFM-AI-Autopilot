# Required: generate a long random secret; never commit the real value.
KRONOS_SERVICE_TOKEN=replace-with-a-long-random-secret

# Free Render Blueprint uses Kronos-small to reduce RAM requirements.
KRONOS_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
TORCH_NUM_THREADS=1
PORT=10000
HF_HOME=/tmp/huggingface
